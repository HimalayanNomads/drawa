{
  "name": "drawa",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc",
    "contrast": "node scripts/contrast.mjs",
    "postinstall": "node -e \"require('fs').cpSync('node_modules/@excalidraw/excalidraw/dist/prod/fonts','public/excalidraw/fonts',{recursive:true,filter:p=>!p.includes('Xiaolai')})\"",
    "lint": "biome check",
    "fix": "biome check --write",
    "format": "biome format --write",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@panzoom/panzoom": "^4.6.2",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "marked": "^18.0.14",
    "mermaid": "^11.17.2",
    "perfect-freehand": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinykeys": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.19",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "5.1.16"
      }
    }
  }
}
